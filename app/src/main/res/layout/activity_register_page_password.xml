<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"  android:background="@drawable/welcome_page_background"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            >

            <LinearLayout
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/iv_back" android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="61dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/back_button_trasparent"
                    app:tint="@color/white"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginTop="280dp"
                    android:layout_marginBottom="94dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Register"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/loginman"
                    android:layout_marginLeft="75dp"
                    android:layout_marginTop="130dp"
                    ></ImageView>

            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Create Password"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingRight="13dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_create_password"
                android:inputType="textPassword"
                android:hint="your password"
                android:background="@null"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingLeft="13dp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_toggle_create"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eye_closed"
                android:padding="2dp"/>
        </LinearLayout>

        <TextView
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Confirm Password"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingRight="13dp"
            android:layout_marginBottom="40dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_confirm_password"
                android:inputType="textPassword"
                android:hint="your password"
                android:background="@null"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingLeft="13dp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_toggle_confirm"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eye_closed"
                android:padding="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_register" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/cr10b4bad73"
            android:paddingVertical="16dp"
            android:layout_marginBottom="25dp"
            android:layout_marginHorizontal="20dp"
            android:elevation="5dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Register"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>