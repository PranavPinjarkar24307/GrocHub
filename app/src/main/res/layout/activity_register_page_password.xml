<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/backgroundgreenelement"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:id="@+id/rrnu6kq9zva"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/rsh3oslv97dq_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            >

            <LinearLayout
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/rvhto3txza5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="61dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/baseline_keyboard_backspace_24"
                    android:tint="@color/white"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/rw6l6qafrvvr"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginTop="280dp"
                    android:layout_marginBottom="94dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Register"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/loginman"
                    android:layout_marginLeft="75dp"
                    android:layout_marginTop="130dp"
                    ></ImageView>

            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/rjwma1m32ywa"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Creat Password"
            />
        <EditText
            android:inputType="text"
            android:hint="your password"
            android:id="@+id/rrbnayirruoo"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingVertical="15dp"
            android:paddingHorizontal="13dp"
            />
        <TextView
            android:id="@+id/rwekxyljtme"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Confirm Password"
            />
        <LinearLayout
            android:id="@+id/ra41e5oc1vz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingRight="13dp"
            android:layout_marginBottom="35dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">
            <EditText
                android:inputType="text"
                android:hint="your password"
                android:background="@null"
                android:id="@+id/ryncpbt3pdqj"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingLeft="13dp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rrp20m42ya9p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/cr10b4bad73"
            android:paddingVertical="16dp"
            android:layout_marginBottom="25dp"
            android:layout_marginHorizontal="20dp"
            android:elevation="5dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ri0frs25g1ml"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Register"
                />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>