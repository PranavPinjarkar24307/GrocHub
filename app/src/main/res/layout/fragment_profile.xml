<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/profile_page_background">

    <!-- SETTINGS ICON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/setting"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- PROFILE SECTION -->
    <LinearLayout
        android:id="@+id/profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        >

        <!-- PROFILE IMAGE WITH RING -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/profile_ring_white"
            android:padding="3dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:srcCompat="@android:drawable/sym_def_app_icon" />
        </FrameLayout>

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading..."
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="loading@example.com"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- DIVIDER AFTER PROFILE -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#33000000" />
    <!-- MENU OPTIONS SCROLL -->
    <ScrollView
        android:id="@+id/menu_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/menu_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Address -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/address_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Delivery Address"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_directions"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Order History -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/order_history_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Order History"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Help -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/help_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Help &amp; Support"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_help"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Payment Methods -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/rg_payment_methods"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Payment Methods"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_save"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Wallet & Rewards -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/wallet_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Wallet &amp; Rewards"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_slideshow"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Dark Mode -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <TextView
                    android:id="@+id/dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Dark Mode"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:drawableStart="@android:drawable/ic_menu_day"
                    android:drawablePadding="12dp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>


    <!-- LOGOUT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:text="Log Out"
        android:textColor="@color/Primary"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/Primary"
        app:strokeWidth="1dp"
        app:backgroundTint="@android:color/transparent" />

</LinearLayout>
