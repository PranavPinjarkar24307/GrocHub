<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.HomeFragment"
    android:background="@drawable/homepagebackground">

    <LinearLayout
        android:id="@+id/ll_home_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_header_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_app_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/applogowithname"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="46dp"
                android:layout_marginBottom="11dp" />

            <LinearLayout
                android:id="@+id/ll_search_notification_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="19dp"
                android:layout_marginHorizontal="21dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_search_bar_clickable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:background="@drawable/cr10bffffff"
                    android:padding="8dp"
                    android:layout_marginEnd="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_search_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/search"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_search_placeholder"
                        android:textColor="#BDBDBD"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Search for fruits, vegetables, groce..." />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_mail_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/baseline_mail_outline_24"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/iv_notification_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/nortification"
                    android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_delivery_location_row"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginBottom="25dp"
                android:layout_marginHorizontal="25dp"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal">

                <LinearLayout
                    android:id="@+id/ll_location_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_location_pin_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/carbon_location"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tv_sent_to_label"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Sent to :"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_delivery_address"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="match_parent"
                        android:layout_width="265dp"
                        android:text="Pamulang Barat Residence No.5, RT 05/ ..."
                        android:layout_marginStart="4dp" />

                    <ImageView
                        android:id="@+id/iv_location_dropdown_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/downarrow"
                        android:scaleType="fitXY" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/homeSlider"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:clipToPadding="false"
                android:background="@android:color/transparent"
                />


            <com.google.android.material.tabs.TabLayout
                android:id="@+id/homeSliderIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/transparent"
                app:tabIndicatorHeight="0dp"
                app:tabRippleColor="@android:color/transparent"
                app:tabMode="fixed"
                app:tabGravity="center"
                app:tabPaddingStart="6dp"
                app:tabPaddingEnd="6dp"
                app:tabMinWidth="0dp"
                app:tabMaxWidth="0dp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>