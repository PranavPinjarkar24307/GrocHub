<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="93dp">

            <ImageView
                android:id="@+id/r4ydvwq8ilww"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/back_button_trasparent"
                android:scaleType="fitXY"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:textColor="#12110D"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Enter the Code" />

            <TextView
                android:textColor="#5A5E60"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="A verification code has been sent to" />

            <TextView
                android:id="@+id/r56362criajk"
                android:textColor="#12110D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="+91 000 000 0000" />

            <EditText
                android:id="@+id/et_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 0 0 0 0 0"
                android:inputType="number"
                android:gravity="center"
                android:maxLength="6"
                android:letterSpacing="0.4"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:paddingVertical="15dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tv_timer"
                android:textColor="#12110D"
                android:textSize="16sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Resend code in 60s"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="25dp" />

            <LinearLayout
                android:id="@+id/r9p525jbg3i7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/add_to_cart_bg"
                android:paddingVertical="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/btn_next_text"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Next" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>