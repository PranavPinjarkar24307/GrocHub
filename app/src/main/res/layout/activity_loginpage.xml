<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@drawable/welcome_page_background"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            >

            <LinearLayout
                android:paddingEnd="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/iv_back" android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="61dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/back_button_trasparent"
                    app:tint="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginTop="280dp"
                    android:layout_marginBottom="94dp"
                    android:layout_marginStart="20dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Login"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/loginman"
                    android:layout_marginLeft="120dp"
                    android:layout_marginTop="130dp" />

            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Email"
            />

        <EditText
            android:inputType="textEmailAddress" android:hint="yourmail@mail.com"
            android:id="@+id/et_email"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingVertical="15dp"
            android:paddingHorizontal="13dp"
            />
        <TextView
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="20dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Password"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/cr10bf2f2f2"
            android:paddingRight="13dp"
            android:layout_marginBottom="6dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">
            <EditText
                android:inputType="textPassword" android:hint="your password"
                android:background="@null"
                android:id="@+id/et_password"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="15dp"
                android:paddingLeft="13dp"
                />
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_password_toggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eye_closed"
                android:padding="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginBottom="18dp"
            android:orientation="vertical">
            <TextView
                android:textColor="#0EB176"
                android:textSize="10sp"
                android:layout_marginEnd="23dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Forgot Password"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_login" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="@drawable/cr10b4bad73"
            android:paddingVertical="16dp"
            android:layout_marginBottom="25dp"
            android:layout_marginHorizontal="20dp"
            android:elevation="5dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Login"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_marginBottom="102dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:textColor="#0EB176"
                    android:textSize="12sp"
                    android:layout_marginEnd="7dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Not have an account?"
                    />
                <TextView
                    android:textColor="#0EB176"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Register"
                    />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>